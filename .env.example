# Credential-free template; see docs/CONFIGURATION.md.
# Configure privately on a new deployment; do not overwrite a working .env.
# One KEY=value per line, no inline comments or quoted values.

# IBKR Settings
IBKR_HOST=127.0.0.1
IBKR_PORT=7497
IBKR_CLIENT_ID=1
IBKR_GATEWAY_ENABLED=false
REQUIRE_GATEWAY=false

# Telegram bot notifications and Telethon news intake use separate credentials.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# API research model; separate from the coding assistant/OpenClaw review model.
# Supported adapters: deepseek, claude, openai. Blank model uses code default.
LLM_PROVIDER=deepseek
LLM_API_KEY=
LLM_MODEL=

# Optional research Chrome health check. Never required for Canadian alerts.
# All browser research is read-only and uses this dedicated profile.
OPENCLAW_BROWSER_CHECK=true
OPENCLAW_RESEARCH_ENABLED=true
OPENCLAW_RESEARCH_MAX_STOCKS=6
OPENCLAW_RESEARCH_TIMEOUT=300
# Session 2 read-only IBKR Paper CDE quote lookups (GET-only allow-list; no orders).
OPENCLAW_IBKR_CHAINS=true
OPENCLAW_IBKR_CHAIN_TIMEOUT=300
OPENCLAW_AI_REVIEW=true
# Trading public-review route only; the global OpenClaw default stays unchanged.
OPENCLAW_REVIEW_CLAUDE_MODEL=anthropic/claude-opus-5-5
OPENCLAW_REVIEW_OPENAI_MODEL=openai/gpt-6.1-sol
OPENCLAW_REVIEW_THINKING=medium
OPENCLAW_REVIEW_TIMEOUT=90
OPENCLAW_REVIEW_FALLBACK=true
OPENCLAW_KEEPALIVE_ENABLED=true
# Opt-in guarded banner reconnect; no credentials or confirmations.
OPENCLAW_PAPER_RECONNECT=false
# Owner opt-in: select Paper and submit only an already-filled official SSO form.
# No password retrieval/typing, password-manager interaction or challenge handling.
OPENCLAW_PAPER_SAVED_LOGIN=false
OPENCLAW_BROWSER_AUTORESTART=true
OPENCLAW_SSH_TARGET=trader@192.0.2.16
OPENCLAW_CLI_PATH=/home/trader/.nvm/versions/node/v24.21.0/bin/openclaw
